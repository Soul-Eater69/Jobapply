# ══════════════════════════════════════════════════════════════════════════════
# JobApply AI — Environment Configuration
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ── AI (Required for resume generation) ───────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here
# Model to use — gpt-4o is recommended, gpt-4o-mini is faster/cheaper
OPENAI_MODEL=gpt-4o

# ── Anthropic / Claude (Required for AI agent layer) ──────────────────────────
# Used by: Job Fit Agent, Cover Letter Agent, Company Research Agent, Follow-Up Agent
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Agent Settings ─────────────────────────────────────────────────────────────
# Minimum fit score (0-100) to proceed with application (65 = good default)
MIN_FIT_SCORE=65
# Days after applying before follow-up email is generated
FOLLOWUP_AFTER_DAYS=7

# ── Job Platform Credentials ──────────────────────────────────────────────────
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

INDEED_EMAIL=your@email.com
INDEED_PASSWORD=yourpassword

GLASSDOOR_EMAIL=your@email.com
GLASSDOOR_PASSWORD=yourpassword

# ── Proxy Configuration (Optional but recommended for stealth) ────────────────
# Comma-separated list of proxies for rotating IP addresses
# Format: http://user:pass@host:port OR http://host:port
# PROXY_LIST=http://proxy1.example.com:8080,http://proxy2.example.com:8080

# ── Browser Settings ──────────────────────────────────────────────────────────
# Set to false to see browser in action (useful for debugging)
HEADLESS=true

# Add artificial slow-down (ms) to browser actions (0 = off)
SLOW_MO=0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./jobapply.db

# ── App Security ──────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string
